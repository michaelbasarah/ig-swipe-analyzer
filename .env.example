# ---- Read the Terms-of-service section of the README before filling this in ----------------
# Nothing touches Instagram until you set this to 1. It is a speed bump, not a legal shield.
SWIPE_ACCEPT_TOS=

# ---- Gemini ---------------------------------------------------------------------------------
GEMINI_API_KEY=
SWIPE_MODEL=gemini-3.5-flash

# ---- Instagram session (YOUR personal account, never one tied to a business) -----------------
# The value of the `sessionid` cookie from a logged-in browser session (DevTools -> Application
# -> Cookies). Public posts often work without it but get throttled; the saved-collection sweep
# cannot work without it. Lives in this env var only: no cookie file is read or written.
IG_SESSIONID=
# Optional, for a non-default gallery-dl binary location
# GALLERY_DL_BIN=gallery-dl

# ---- Google Sheet ---------------------------------------------------------------------------
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
SWIPE_SHEET_ID=
# Optional tab name (defaults to the first tab). The header row writes itself on first use.
SWIPE_SHEET_TAB=
# Service account: paste the JSON on one line, or point at the file. Then share the sheet with the
# service account's client_email as an Editor, or every write is a 403.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---- Your niche (optional, one sentence) -----------------------------------------------------
# Shapes the "how I'd reuse it" column. Blank = generic.
# SWIPE_NICHE=I make short-form videos about home cooking for busy students

# ---- Reels: let Gemini watch the actual video -------------------------------------------------
# On by default. Set to 0 to analyse caption + cover frame only (cheaper, less accurate).
SWIPE_REEL_VIDEO=1
SWIPE_REEL_MAX_MB=20
SWIPE_REEL_MAX_SECONDS=90

# ---- Saved-collection sweep ------------------------------------------------------------------
# A dedicated collection's URL, e.g. https://www.instagram.com/<you>/saved/<collection>/<id>/
SWIPE_SAVED_URL=
SWIPE_SWEEP_MAX_PER_RUN=5
SWIPE_SWEEP_LIST_LIMIT=30
SWIPE_SWEEP_MAX_ATTEMPTS=3
SWIPE_SWEEP_DELAY_SECONDS=20
# SWIPE_STATE_FILE=.swipe-state.json

# ---- Optional Discord trigger ----------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs the bot obeys. EMPTY MEANS NOBODY.
DISCORD_USER_IDS=

# LOG_LEVEL=debug
